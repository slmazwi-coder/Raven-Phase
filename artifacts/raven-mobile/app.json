{
  "expo": {
    "name": "Raven",
    "slug": "raven-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "raven-mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B141A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.raven.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Raven needs microphone access for voice calls and voice notes.",
        "NSCameraUsageDescription": "Raven needs camera access for photos and future video calls."
      }
    },
    "android": {
      "package": "com.raven.app",
      "backgroundColor": "#0B141A",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.BLUETOOTH",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "./plugins/withRavenSecurity.js",
      "@config-plugins/react-native-webrtc"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "1f8c8173-444b-4199-953b-73fee373c161"
      }
    },
    "owner": "boetsomies-team"
  }
}
